# Web + API.
# frontier: DOMAIN=http://<FRONTIER_ALIAS> (Host = alias Docker na rede frontier).
# local: DOMAIN=:80 (publicado como HTTP_PORT no host).
{$DOMAIN} {
	encode gzip

	handle /api/* {
		import /etc/caddy/upstream.caddy
	}

	handle {
		root * /opt/atual
		try_files {path} /index.html
		file_server
	}
}
