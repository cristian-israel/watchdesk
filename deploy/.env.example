# Produção: copie para deploy/.env e preencha.

COMPOSE_PROJECT_NAME=sala-tela

# Domínio (Let's Encrypt) ou :80 na rede interna
DOMAIN=:80

HTTP_PORT=80
HTTPS_PORT=443

# Host/DNS público para candidatos ICE do WebRTC (sem https://)
PUBLIC_HOST=

# Perfis: blue ou green (slot ativo da API)
COMPOSE_PROFILES=blue

SOURCE=browser
PORT=9000

API_MEMORY_LIMIT=512m
API_CPUS=1.0
CADDY_MEMORY_LIMIT=256m
CADDY_CPUS=0.5
