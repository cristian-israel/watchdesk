# Produção: copie para deploy/.env, mantenha privado e preencha com valores reais.
# Cada instalação: um diretório de deploy e um par COMPOSE_PROJECT_NAME / EDGE_ALIAS.
# Instalações novas: use o mesmo valor nos dois, ex. watchdesk ou watchdesk-prod.
# Sem TUNNEL_TOKEN aqui — o túnel fica só no vps-prod.
# Imagens (API/Caddy/web) não entram neste arquivo; tags vêm dos scripts de atualização.

# --- Projeto / borda ---
COMPOSE_PROJECT_NAME=watchdesk
EDGE_ALIAS=watchdesk

# --- WebRTC (ICE) ---
# Host ou IP público que o browser usa na porta 8189 (sem https://).
# Em geral o IP da VPS, ou DNS A direto (não o domínio do Tunnel / nuvem laranja).
PUBLIC_HOST=

# --- App ---
SOURCE=browser
PORT=9000
COMPOSE_PROFILES=blue

# --- Limites ---
# Defaults do Compose: API 512m; Caddy 256m. Ajuste à VPS se precisar.
API_MEMORY_LIMIT=512m
API_CPUS=1.0
API_PIDS_LIMIT=256
API_TMP_SIZE=256m
CADDY_MEMORY_LIMIT=256m
CADDY_CPUS=0.5
