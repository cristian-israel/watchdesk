# Produção: copie para deploy/.env e preencha.

COMPOSE_PROJECT_NAME=watchdesk

# Atrás do Cloudflare Tunnel use :80 (TLS na Cloudflare).
# Sem túnel / LAN direta, ainda assim :80 — 80/443 não são publicados no host.
DOMAIN=:80

# Host/DNS (ou IP público) para candidatos ICE do WebRTC — sem https://
# Ex.: watchdesk.seudominio.com ou o IP da VPS (porta 8189 precisa estar aberta)
PUBLIC_HOST=

# Perfis: blue ou green (slot ativo da API)
COMPOSE_PROFILES=blue

SOURCE=browser
PORT=9000

API_MEMORY_LIMIT=512m
API_CPUS=1.0
CADDY_MEMORY_LIMIT=256m
CADDY_CPUS=0.5
