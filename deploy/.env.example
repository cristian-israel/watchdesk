# Produção: copie para deploy/.env, mantenha privado e preencha com valores reais.
# Cada instalação: um diretório de deploy e um par COMPOSE_PROJECT_NAME / EDGE_ALIAS.
# Instalações novas: use o mesmo valor nos dois, ex. watchdesk ou watchdesk-prod.
# Sem TUNNEL_TOKEN aqui — o túnel fica só no vps-prod.
# Imagens (API/Caddy/web) não entram neste arquivo; tags vêm dos scripts de atualização.

# --- Projeto / borda ---
COMPOSE_PROJECT_NAME=watchdesk
EDGE_ALIAS=watchdesk

# --- Portas ---
# API HTTP/WS (rede Docker / Caddy; não publicada no host)
PORT=7030

# --- MySQL (já existente na VPS; sem serviço mysql neste Compose) ---
# Ex.: mysql://watchdesk:SENHA@mysql:3306/watchdesk
# Se o MySQL estiver noutro Compose, coloque a API na mesma rede Docker ou use o IP/host alcançável.
DATABASE_URL=

# --- WebRTC ICE / TURN ---
# IP público da VPS (anúncio Coturn). Não use o hostname do Tunnel / nuvem laranja.
PUBLIC_HOST=
# Segredo compartilhado API ↔ Coturn (gere um valor longo e aleatório).
TURN_SECRET=
# Host anunciado aos browsers (padrão = PUBLIC_HOST se vazio na API).
TURN_HOST=
TURN_PORT=3478
TURN_REALM=watchdesk

# --- App ---
# URL pública HTTPS do site (links de convite). Ex.: https://watchdesk.ilumea.com.br
# Não use o IP da VPS — HTTP entra pelo túnel/DNS.
PUBLIC_ORIGIN=
COMPOSE_PROFILES=blue

# --- Limites ---
API_MEMORY_LIMIT=512m
API_CPUS=1.0
API_PIDS_LIMIT=256
API_TMP_SIZE=64m
CADDY_MEMORY_LIMIT=256m
CADDY_CPUS=0.5
