# Produção: copie para deploy/.env, mantenha privado e preencha com valores reais.
# Cada instalação: um diretório de deploy e um par COMPOSE_PROJECT_NAME / FRONTIER_ALIAS.
# Instalações novas: use o mesmo valor nos dois, ex. watchdesk ou watchdesk-prod.
# Túnel Cloudflare fica no prod-hub — sem TUNNEL_TOKEN aqui.
# Imagens (API/Caddy/web) não entram neste arquivo; tags vêm dos scripts de atualização.

# --- Projeto / frontier ---
COMPOSE_PROJECT_NAME=watchdesk
FRONTIER_ALIAS=watchdesk
# Nomes das redes do prod-hub (multi-túnel: frontier-dominio-a, etc.)
FRONTIER_NETWORK=frontier
INFRA_NETWORK=infra

# frontier (caminho feliz — alias na rede frontier do prod-hub):
#   DOMAIN = http://<FRONTIER_ALIAS> (Host = nome Docker na rede frontier).
#   Túnel Cloudflare e alias/sites precisam de HTTP Host Header = FRONTIER_ALIAS.
# local (lab): DOMAIN=:80 + HTTP_PORT / HTTPS_PORT
DOMAIN=http://watchdesk

# --- Portas no host (só profile `local`; TURN publica 3478 e 50100–50200 sempre) ---
HTTP_PORT=80
HTTPS_PORT=443
# API HTTP/WS (rede Docker / Caddy; não publicada no host)
PORT=7030

# --- Perfis (só borda / MySQL local) ---
#   frontier -> Caddy na rede frontier do prod-hub (sem portas no host)
#   local    -> Caddy com portas no host (+ mysql se listado ou via local)
#   mysql    -> MySQL neste Compose (senão DATABASE_URL na infra do hub)
# NÃO coloque blue/green aqui — use scripts/subir.sh e atualizar-*.sh.
#
# Caminho feliz (Cloudflare + MySQL na infra do prod-hub):
COMPOSE_PROFILES=frontier
# COMPOSE_PROFILES=frontier,mysql
# COMPOSE_PROFILES=local,mysql

# --- MySQL ---
# Sem profile mysql: DATABASE_URL aponta para o mysql na rede infra do prod-hub.
# DATABASE_URL=mysql://watchdesk:senha@mysql:3306/watchdesk
# Com profile mysql ou local, MYSQL_PASSWORD (ou DATABASE_URL) é obrigatório.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- WebRTC ICE / TURN ---
# IP alcançável pelos peers (LAN ou público). Anúncio Coturn — não use hostname Cloudflare laranja.
PUBLIC_HOST=
# Segredo compartilhado API ↔ Coturn (gere um valor longo e aleatório).
TURN_SECRET=
# Host anunciado aos browsers (padrão = PUBLIC_HOST se vazio na API).
TURN_HOST=
TURN_PORT=3478
TURN_REALM=watchdesk

# --- Limites ---
# URL do site = DNS no prod-hub (alias/túnel). Convites: front usa location.origin.
# WS: Origin casa com X-Forwarded-Host (Caddy preserva o header do porteiro).
API_MEMORY_LIMIT=512m
API_CPUS=1.0
API_PIDS_LIMIT=256
API_TMP_SIZE=64m
CADDY_MEMORY_LIMIT=256m
CADDY_CPUS=0.5
