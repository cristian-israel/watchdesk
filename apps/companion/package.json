{
  "name": "@watchdesk/companion",
  "private": true,
  "version": "0.2.0",
  "description": "Companion Watchdesk — console do host (salas, captura, controle)",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack:win": "electron-builder --win --x64",
    "pack:linux": "electron-builder --linux AppImage --x64",
    "pack": "electron-builder --win --x64 --linux AppImage --x64"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "br.ilumea.watchdesk.companion",
    "productName": "Watchdesk Companion",
    "directories": {
      "output": "dist"
    },
    "protocols": [
      {
        "name": "Watchdesk Companion",
        "schemes": ["watchdesk"]
      }
    ],
    "win": {
      "target": ["nsis"],
      "artifactName": "watchdesk-companion-setup.${ext}"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Network",
      "artifactName": "watchdesk-companion-${version}.${ext}"
    },
    "files": ["src/**/*", "package.json"]
  },
  "engines": {
    "node": ">=18"
  }
}
